    const H = Math.round(S.size * 1.5), base = Math.round(S.size * 1.12);
    rows.innerHTML = L.map(({ f, ok, m, w }) => { const dx = (m.x / mr.x - 1) * 100, dw = (w / wr - 1) * 100, pi = S.pins.indexOf(f.fam), sg = v => (v >= 0 ? '+' : '−') + fr(Math.abs(v), 1) + ' %';
      return `<div class="mrow ${ok ? '' : 'miss'}"><div class="minfo"><b>${f.label}</b><div class="mm"><span>Hauteur d’x</span><span>${fr(m.x * 100, 1)} %</span><span>Capitales</span><span>${fr(m.cap * 100, 1)} %</span><span>Largeur</span><span>${Math.round(w)} px</span></div>${f === ref ? '<span class="delta">Référence</span>' : `<span class="delta ${dx >= 0 ? 'up' : 'dn'}">x ${sg(dx)} · largeur ${sg(dw)} face à ${ref.label}</span>`}<button class="pinb ${pi >= 0 ? 'on' : ''}" style="--pc:${PC[pi] || ''}" data-pin="${f.fam}">${pi >= 0 ? 'Épinglée' : 'Épingler'}</button></div>
        <div class="cell"><svg height="${H}"><line class="gl" x1="0" x2="100%" y1="${base}" y2="${base}"/><line class="gl ref" x1="0" x2="100%" y1="${base - mr.x * S.size}" y2="${base - mr.x * S.size}"/><line class="gl own" x1="0" x2="${Math.round(w)}" y1="${base - m.x * S.size}" y2="${base - m.x * S.size}"/><text x="0" y="${base}" font-size="${S.size}" fill="currentColor" style="font-family:${f.css}">${esc(S.text)}</text></svg></div></div>`; }).join('');
    paintOver();
  }
  rows.addEventListener('click', e => { const b = e.target.closest('[data-pin]'); if (!b) return; const i = S.pins.indexOf(b.dataset.pin); if (i >= 0) S.pins.splice(i, 1); else { if (S.pins.length >= 3) S.pins.shift(); S.pins.push(b.dataset.pin); } paint(); });
  st.addEventListener('click', e => { const b = e.target.closest('[data-c]'); if (b) { S.c = b.dataset.c; paint(); } });
  st.addEventListener('input', e => { if (e.target.matches('[data-text]')) { S.text = e.target.value || PARAMS.tableText; paint(); } if (e.target.matches('[data-size]')) { S.size = +e.target.value; paint(); } });
  st.addEventListener('change', e => { if (e.target.matches('[data-sort]')) { S.sort = e.target.value; paint(); } });
  THEME_HOOK = paintOver;
  paint();
}
