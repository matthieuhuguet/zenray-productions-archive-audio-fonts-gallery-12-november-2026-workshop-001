const countK = () => SOUNDS.reduce((a, s) => (a[s.k] = (a[s.k] || 0) + 1, a), {});

/* ───────── AUDIO A: Mur d'ondes ───────── */
function audioWall(st) {
  const S = { q: '', k: 'all', sel: 'lens-flare', hover: PARAMS.hoverListen, fav: new Set(['lens-flare', 'theme-des-eclats', 'valider']), byHover: false };
  st.innerHTML = `<div class="tb"><h2>Audio</h2><span class="count" data-count></span><input class="search" placeholder="Chercher un son, un tag, un projet"><div class="chips" data-chips></div><span class="sp"></span>
    <label class="mini">Taille <input type="range" min="150" max="330" value="${PARAMS.tile}" data-size></label><label class="sw"><input type="checkbox" ${S.hover ? 'checked' : ''} data-hover> Écoute au survol</label></div>
    <div class="wall" data-wall style="--tile:${PARAMS.tile}px"></div><div class="dock" data-dock></div>`;
  const wall = $('[data-wall]', st), dock = $('[data-dock]', st), chips = $('[data-chips]', st);
  const ORDER = SOUNDS.map((s, i) => SOUNDS[(i * PARAMS.wallStride) % SOUNDS.length]);
  const list = () => ORDER.filter(s => (S.k === 'all' || (S.k === 'fav' ? S.fav.has(s.id) : s.k === S.k)) && match(s, S.q));
  const tile = id => $(`.tile[data-id="${id}"]`, wall);
  function paintChips() { chips.innerHTML = kindChips(countK(), S.k, `<button class="chip ${S.k === 'fav' ? 'on' : ''}" data-k="fav">★ Favoris <b>${S.fav.size}</b></button>`); }
  function paint() {
    const L = list(); $('[data-count]', st).textContent = `${L.length} sons · ${fmtDur(L.reduce((a, s) => a + data(s).dur, 0))} de matière`;
    wall.innerHTML = L.map(s => `<div class="tile k-${s.k} ${s.loop ? 'wide' : ''} ${s.id === S.sel ? 'sel' : ''}" data-id="${s.id}" tabindex="0"><span class="tl"><i class="dotk"></i>${KINDS[s.k]}${s.loop ? ' · boucle' : ''}</span><span class="tr">${fmtDur(data(s).dur)}</span><canvas></canvas><div class="nm">${s.name}</div><div class="mt">${metaLine(s)}</div><button class="fav ${S.fav.has(s.id) ? 'on' : ''}" title="Favori (F)">★</button></div>`).join('') || '<div class="empty">Aucun son ne correspond. Efface la recherche ou change de famille.</div>';
    $$('.tile', wall).forEach(t => drawWave($('canvas', t), byId(t.dataset.id)));
  }
  function paintDock() {
    const s = byId(S.sel), d = data(s); dock.className = 'dock k-' + s.k;
    dock.innerHTML = `<button class="playbtn" data-play title="Lire ou arrêter (Espace)">▶</button><div style="min-width:0"><div class="ti">${s.name}</div><div class="pa mono">${s.path}</div><div class="facts"><span class="fact"><b>${fmtDur(d.dur)}</b></span>${s.bpm ? `<span class="fact"><b>${s.bpm}</b> BPM</span>` : ''}${s.key ? `<span class="fact"><b>${s.key}</b></span>` : ''}<span class="fact"><b>${fr(d.lufs, 1)}</b> LUFS</span><span class="fact">WAV 48 kHz, 24 bits</span><span class="fact">${s.project}</span></div></div><canvas data-big></canvas>
      <div class="acts"><button class="btn" data-copy="${s.path}">Copier le chemin</button><button class="btn" data-say="Envoyé vers la piste Sons de Motion">Vers Motion</button><button class="btn" data-say="Copié dans Content/Audio du projet Unreal">Vers Unreal</button><button class="btn" data-say="Sons proches affichés">Sons proches</button></div>`;
    drawWave($('[data-big]', dock), s);
  }
  function select(id, from = 0, play = true) { const p = tile(S.sel); if (p) p.classList.remove('sel'); S.sel = id; const t = tile(id); if (t) { t.classList.add('sel'); t.scrollIntoView({ block: 'nearest' }); } paintDock(); if (play) { needSound(); AU.play(byId(id), { from: from * data(byId(id)).dur }); S.byHover = false; } }
  wall.addEventListener('click', e => { const t = e.target.closest('.tile'); if (!t) return; if (e.target.closest('.fav')) { const id = t.dataset.id; S.fav.has(id) ? S.fav.delete(id) : S.fav.add(id); e.target.classList.toggle('on'); paintChips(); return; } const c = $('canvas', t), r = c.getBoundingClientRect(), from = e.target === c ? (e.clientX - r.left) / r.width : 0; AU.on(); select(t.dataset.id, from); });
  wall.addEventListener('mouseover', e => { const t = e.target.closest('.tile'); if (!t || t.contains(e.relatedTarget) || !S.hover) return; if (!AU.ready()) return needSound(); AU.play(byId(t.dataset.id)); S.byHover = true; });
  wall.addEventListener('mouseout', e => { const t = e.target.closest('.tile'); if (!t || t.contains(e.relatedTarget)) return; if (S.byHover && AU.cur && AU.cur.id === t.dataset.id) AU.stop(); });
  dock.addEventListener('click', e => { if (e.target.closest('[data-play]')) { AU.on(); AU.cur && AU.cur.id === S.sel ? AU.stop() : select(S.sel); } const c = e.target.closest('[data-big]'); if (c) { const r = c.getBoundingClientRect(); AU.on(); select(S.sel, (e.clientX - r.left) / r.width); } });
  chips.addEventListener('click', e => { const b = e.target.closest('[data-k]'); if (!b) return; S.k = b.dataset.k; paintChips(); paint(); });
  $('.search', st).addEventListener('input', e => { S.q = e.target.value; paint(); });
  $('[data-size]', st).addEventListener('input', e => { wall.style.setProperty('--tile', e.target.value + 'px'); $$('.tile', wall).forEach(t => drawWave($('canvas', t), byId(t.dataset.id))); });
  $('[data-hover]', st).addEventListener('change', e => { S.hover = e.target.checked; });
  onWin('keydown', e => { if (e.target.matches('input,select,textarea')) return; const L = list(), i = L.findIndex(s => s.id === S.sel); const cols = Math.max(1, Math.round(wall.clientWidth / (parseFloat(getComputedStyle(wall).getPropertyValue('--tile')) + 14))); const mv = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: cols, ArrowUp: -cols }[e.key];
    if (mv) { e.preventDefault(); const n = L[Math.max(0, Math.min(L.length - 1, i + mv))]; if (n) select(n.id); } else if (e.code === 'Space') { e.preventDefault(); AU.cur && AU.cur.id === S.sel ? AU.stop() : select(S.sel); } else if (e.key.toLowerCase() === 'f') { const t = tile(S.sel); if (t) $('.fav', t).click(); } });
  let last = null;
  TICK = () => { const h = AU.cur, id = h ? h.id : null; if (last && last !== id) { const t = tile(last); if (t) { t.classList.remove('playing'); drawWave($('canvas', t), byId(last)); } if (last === S.sel) drawWave($('[data-big]', dock), byId(last)); } if (h) { const p = AU.prog(h), t = tile(id); if (t) { t.classList.add('playing'); drawWave($('canvas', t), byId(id), p); } if (id === S.sel) drawWave($('[data-big]', dock), byId(id), p); } $('[data-play]', dock).textContent = h && id === S.sel ? '■' : '▶'; last = id; };
  paintChips(); paint(); paintDock();
}

/* ───────── AUDIO B: Pads ───────── */
const PAD_CODES = ['Digit1', 'Digit2', 'Digit3', 'Digit4', 'Digit5', 'Digit6', 'KeyQ', 'KeyW', 'KeyE', 'KeyR', 'KeyT', 'KeyY', 'KeyA', 'KeyS', 'KeyD', 'KeyF', 'KeyG', 'KeyH', 'KeyZ', 'KeyX', 'KeyC', 'KeyV', 'KeyB', 'KeyN'];
function audioPads(st) {
  const banks = ['Tout', 'ZenRayShards', 'UI', 'Motion', 'Louisiana Bayou'], S = { bank: PARAMS.padBank, seq: [], vol: 0.55 };
  let labels = PAD_CODES.map(c => c.replace('Digit', '').replace('Key', ''));
  const beds = SOUNDS.filter(s => s.loop);
  st.innerHTML = `<div class="padwrap"><div class="padmain"><div class="tb"><h2>Audio</h2><div class="chips" data-banks></div><span class="sp"></span><span class="hint">Joue au clavier, les sons se superposent</span></div>
    <div class="pads" data-pads></div><div class="seq" data-seq></div></div>
    <div class="beds"><h3>Lit sonore</h3><p>Lance une musique ou une ambiance, puis joue les effets par-dessus pour les juger en situation.</p>${beds.map(s => `<div class="bed k-${s.k}" data-id="${s.id}"><button class="pb">▶</button><div style="min-width:0"><div class="bn">${s.name}</div><div class="bm">${KINDS[s.k]}${s.bpm ? ' · ' + s.bpm + ' BPM' : ''}${s.key ? ' · ' + s.key : ''}</div><canvas></canvas></div><input type="range" min="0" max="1" step="0.01" value="${S.vol}" title="Niveau du lit"></div>`).join('')}</div></div>`;
  const padsEl = $('[data-pads]', st), seqEl = $('[data-seq]', st), bk = $('[data-banks]', st);
  const pads = () => SOUNDS.filter(s => !s.loop && (S.bank === 'Tout' || s.project === S.bank)).slice(0, PAD_CODES.length);
  function paint() {
    bk.innerHTML = banks.map(b => `<button class="chip ${b === S.bank ? 'on' : ''}" data-b="${b}">${b}</button>`).join('');
    padsEl.innerHTML = pads().map((s, i) => `<button class="pad k-${s.k}" data-id="${s.id}" title="${s.name} · ${metaLine(s)}"><span class="kbd">${labels[i]}</span><span class="pd">${fmtDur(data(s).dur)}</span><canvas></canvas><span class="pn">${s.name}</span></button>`).join('');
    $$('.pad', padsEl).forEach(p => drawSigil($('canvas', p), byId(p.dataset.id)));
  }
  function paintSeq(now = -1) { seqEl.innerHTML = `<span class="lab">Séquence</span>` + (S.seq.length ? S.seq.map((h, i) => `<span class="hitc k-${byId(h.id).k} ${i === now ? 'now' : ''}"><i class="dotk"></i>${byId(h.id).name}<i>${i ? '+' + fr((h.t - S.seq[i - 1].t) / 1000) + ' s' : '0'}</i></span>`).join('') + `<span class="sp"></span><button class="btn" data-replay>Rejouer</button><button class="btn" data-say="Séquence envoyée vers la piste Sons de Motion">Vers Motion</button><button class="btn" data-clear>Effacer</button>` : `<span class="hint">Chaque pad joué s’inscrit ici avec son écart de temps, pour rejouer ou exporter l’enchaînement.</span>`); seqEl.scrollLeft = 1e6; }
  function flash(id) { const p = $(`.pad[data-id="${id}"]`, padsEl); if (p) { p.classList.remove('hit'); void p.offsetWidth; p.classList.add('hit'); } }
  function hit(id, rec = true) { AU.on(); if (!AU.ready()) return needSound(); AU.play(byId(id), { poly: true }); flash(id); if (rec) { S.seq.push({ id, t: performance.now() }); if (S.seq.length > 12) S.seq.shift(); paintSeq(); } }
  padsEl.addEventListener('pointerdown', e => { const p = e.target.closest('.pad'); if (p) { AU.on(); setTimeout(() => hit(p.dataset.id), 0); } });
  bk.addEventListener('click', e => { const b = e.target.closest('[data-b]'); if (b) { S.bank = b.dataset.b; paint(); } });
  seqEl.addEventListener('click', e => { if (e.target.closest('[data-clear]')) { S.seq = []; paintSeq(); } if (e.target.closest('[data-replay]') && S.seq.length) { const t0 = S.seq[0].t; S.seq.forEach((h, i) => timer(() => { hit(h.id, false); paintSeq(i); }, h.t - t0)); } });
  $('.beds', st).addEventListener('click', e => { const b = e.target.closest('.bed'); if (!b || e.target.matches('input')) return; AU.on(); setTimeout(() => { if (!AU.ready()) return needSound(); const was = b.classList.contains('on'); $$('.bed', st).forEach(x => { x.classList.remove('on'); $('.pb', x).textContent = '▶'; }); if (was) AU.bedStop(); else { AU.bedPlay(byId(b.dataset.id), +$('input', b).value); b.classList.add('on'); $('.pb', b).textContent = '■'; } }, 0); });
  $('.beds', st).addEventListener('input', e => { if (e.target.matches('input[type=range]') && AU.bed) AU.bed.g.gain.value = +e.target.value; });
  onWin('keydown', e => { if (e.target.matches('input,select,textarea') || e.repeat || e.metaKey || e.ctrlKey) return; const i = PAD_CODES.indexOf(e.code), s = pads()[i]; if (s) { e.preventDefault(); hit(s.id); } });
  if (navigator.keyboard && navigator.keyboard.getLayoutMap) navigator.keyboard.getLayoutMap().then(m => { labels = PAD_CODES.map((c, i) => (m.get(c) || labels[i]).toUpperCase()); paint(); }).catch(() => {});
  let lastBed = null;
  TICK = () => { const h = AU.bed, id = h ? h.id : null; if (lastBed && lastBed !== id) drawWave($(`.bed[data-id="${lastBed}"] canvas`, st), byId(lastBed)); if (h) drawWave($(`.bed[data-id="${id}"] canvas`, st), byId(id), AU.prog(h)); lastBed = id; };
  paint(); paintSeq(); $$('.bed', st).forEach(b => drawWave($('canvas', b), byId(b.dataset.id)));
}

/* ───────── AUDIO C: Constellation ───────── */
function audioMap(st) {
  const AX = { bright: ['Grave', 'Brillance', 'Aigu'], dur: ['Court', 'Durée', 'Long'], lufs: ['Doux', 'Niveau', 'Fort'], bpm: ['Sans tempo', 'Tempo', 'Rapide'] };
  const S = { x: 'bright', y: 'dur', off: new Set(), hover: true, pins: ['eclat-de-cristal', 'theme-des-eclats'], cur: null };
  const D = SOUNDS.map(s => data(s)), span = (f) => { const v = D.map(f); return [Math.min(...v), Math.max(...v)]; };
  const R = { dur: span(d => Math.log(d.dur)), lufs: span(d => d.lufs) };
  const val = (s, a) => { const d = data(s); return a === 'bright' ? d.bright : a === 'dur' ? (Math.log(d.dur) - R.dur[0]) / (R.dur[1] - R.dur[0]) : a === 'lufs' ? (d.lufs - R.lufs[0]) / (R.lufs[1] - R.lufs[0]) : s.bpm ? 0.25 + 0.75 * (s.bpm - 60) / 80 : 0.04 + (s.i % 7) * 0.012; };
  const pos = s => { const j = rng(s.i * 31 + 5), x = 6 + 88 * val(s, S.x) + (j() - 0.5) * 2.4, y = 92 - 84 * val(s, S.y) + (j() - 0.5) * 2.4; return [Math.max(4, Math.min(96, x)), Math.max(6, Math.min(92, y))]; };
  const opt = cur => Object.keys(AX).map(a => `<option value="${a}" ${a === cur ? 'selected' : ''}>${AX[a][1]}</option>`).join('');
  st.innerHTML = `<div class="tb"><h2>Audio</h2><div class="chips" data-chips></div><span class="sp"></span><label class="mini">Horizontal <select data-ax="x">${opt(S.x)}</select></label><label class="mini">Vertical <select data-ax="y">${opt(S.y)}</select></label><label class="sw"><input type="checkbox" checked data-hover> Écoute au survol</label></div>
    <div class="mapwrap"><div class="map" data-map><svg></svg><div class="axis x"></div><div class="axis y"></div>${SOUNDS.map(s => `<button class="dot k-${s.k}" data-id="${s.id}" style="--s:${Math.round(11 + 15 * val(s, 'lufs'))}px" aria-label="${s.name}"></button>`).join('')}<div class="tip" data-tip><b></b><span></span><canvas></canvas></div></div>
    <div class="tray"><h3>Sélection</h3><p>Survole la carte pour écouter, clique un point pour le garder ici. Les traits relient les trois sons les plus proches.</p><div data-picks style="display:flex;flex-direction:column;gap:8px"></div><span class="sp"></span><button class="btn" data-copy-picks>Copier les chemins</button><button class="btn" data-say="Collection créée depuis la sélection">Créer une collection</button></div></div>`;
  const map = $('[data-map]', st), svg = $('svg', map), tip = $('[data-tip]', st), picks = $('[data-picks]', st), chips = $('[data-chips]', st);
  let P = {};
  function layout() { SOUNDS.forEach(s => { const [x, y] = pos(s); P[s.id] = [x, y]; const d = $(`.dot[data-id="${s.id}"]`, map); d.style.left = x + '%'; d.style.top = y + '%'; d.classList.toggle('off', S.off.has(s.k)); d.classList.toggle('pin', S.pins.includes(s.id)); }); $('.axis.x', map).innerHTML = AX[S.x].map(t => `<span>${t}</span>`).join(''); $('.axis.y', map).innerHTML = AX[S.y].map(t => `<span>${t}</span>`).join(''); svg.innerHTML = ''; }
  function paintChips() { const c = countK(); chips.innerHTML = Object.keys(KINDS).map(k => `<button class="chip k-${k} ${S.off.has(k) ? '' : 'on'}" data-k="${k}"><i class="dotk"></i>${KINDS[k]} <b>${c[k]}</b></button>`).join(''); }
  function paintPicks() { picks.innerHTML = S.pins.map(id => { const s = byId(id); return `<div class="pick k-${s.k}" data-id="${id}"><b>${s.name}</b><button class="x" title="Retirer">✕</button><canvas></canvas></div>`; }).join('') || '<p>Rien de gardé pour l’instant.</p>'; $$('.pick', picks).forEach(p => drawWave($('canvas', p), byId(p.dataset.id))); }
  function near(id) { const [x, y] = P[id]; return SOUNDS.filter(s => s.id !== id && !S.off.has(s.k)).map(s => [Math.hypot(P[s.id][0] - x, (P[s.id][1] - y) * 0.6), s.id]).sort((a, b) => a[0] - b[0]).slice(0, 3).map(a => a[1]); }
  function focus(id) { const s = byId(id), [x, y] = P[id]; S.cur = id; svg.innerHTML = near(id).map(n => `<line x1="${x}%" y1="${y}%" x2="${P[n][0]}%" y2="${P[n][1]}%"/>`).join(''); $('b', tip).textContent = s.name; $('span', tip).textContent = `${KINDS[s.k]} · ${fmtDur(data(s).dur)}${s.bpm ? ' · ' + s.bpm + ' BPM' : ''} · ${s.project}`; tip.style.left = (x > 68 ? `calc(${x}% - 226px)` : `calc(${x}% + 16px)`); tip.style.top = (y > 70 ? `calc(${y}% - 96px)` : `calc(${y}% + 12px)`); tip.classList.add('on'); drawWave($('canvas', tip), s); $$('.dot.on', map).forEach(d => d.classList.remove('on')); $(`.dot[data-id="${id}"]`, map).classList.add('on'); }
  map.addEventListener('mouseover', e => { const d = e.target.closest('.dot'); if (!d) return; focus(d.dataset.id); if (S.hover) { if (!AU.ready()) return needSound(); AU.play(byId(d.dataset.id), { loop: false }); } });
  map.addEventListener('mouseleave', () => { tip.classList.remove('on'); svg.innerHTML = ''; $$('.dot.on', map).forEach(d => d.classList.remove('on')); S.cur = null; AU.stop(); });
  map.addEventListener('click', e => { const d = e.target.closest('.dot'); if (!d) return; const id = d.dataset.id; AU.on(); S.pins.includes(id) ? S.pins.splice(S.pins.indexOf(id), 1) : S.pins.unshift(id); d.classList.toggle('pin'); paintPicks(); focus(id); setTimeout(() => AU.play(byId(id), { loop: false }), 0); });
  picks.addEventListener('click', e => { const p = e.target.closest('.pick'); if (!p) return; if (e.target.closest('.x')) { S.pins.splice(S.pins.indexOf(p.dataset.id), 1); layout(); paintPicks(); return; } AU.on(); setTimeout(() => { needSound(); AU.play(byId(p.dataset.id), { loop: false }); }, 0); });
  chips.addEventListener('click', e => { const b = e.target.closest('[data-k]'); if (!b) return; S.off.has(b.dataset.k) ? S.off.delete(b.dataset.k) : S.off.add(b.dataset.k); paintChips(); layout(); });
  st.addEventListener('change', e => { if (e.target.dataset.ax) { S[e.target.dataset.ax] = e.target.value; layout(); } if (e.target.matches('[data-hover]')) S.hover = e.target.checked; });
  st.addEventListener('click', e => { if (e.target.closest('[data-copy-picks]')) copy(S.pins.map(id => byId(id).path).join('\n'), 'Chemins copiés'); });
  let lastT = null;
  TICK = () => { const h = AU.cur; if (h && S.cur === h.id) drawWave($('canvas', tip), byId(h.id), AU.prog(h)); const pk = h && $(`.pick[data-id="${h.id}"] canvas`, picks); if (lastT && lastT !== pk) drawWave(lastT, byId(lastT.parentNode.dataset.id)); if (pk) drawWave(pk, byId(h.id), AU.prog(h)); lastT = pk || null; };
  paintChips(); layout(); paintPicks();
}
